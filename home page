                );

            background-size: cover;

            background-position: center;

        }


        .hero-content {

            max-width: 720px;

            animation:
                heroAppear 0.8s ease;

        }


        @keyframes heroAppear {

            from {

                opacity: 0;

                transform: translateY(25px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }


        .hero-badge {

            display: inline-block;

            background: #e0e7ff;

            color: #4338ca;

            padding: 8px 15px;

            border-radius: 30px;

            font-size: 14px;

            font-weight: bold;

            margin-bottom: 20px;

        }


        .hero h1 {

            font-size: clamp(42px, 6vw, 65px);

            line-height: 1.05;

            margin-bottom: 22px;

            letter-spacing: -2px;

        }


        .hero h1 span {

            color: #4f46e5;

        }


        .hero p {

            font-size: 19px;

