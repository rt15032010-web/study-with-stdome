            transform: translateY(-2px);

        }


        .secondary-btn {

            background: white;

            color: #4f46e5;

            border: 1px solid #c7d2fe;

            padding: 14px 25px;

            border-radius: 9px;

            font-size: 16px;

            cursor: pointer;

            transition: 0.25s;

        }


