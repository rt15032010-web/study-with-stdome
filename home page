<script>


/* =====================================================
   NAVIGATION
===================================================== */

function goHome() {

    window.scrollTo({

        top: 0,

        behavior: "smooth"

    });

}


function scrollToClasses() {

    document
        .getElementById("classes")
        .scrollIntoView({

            behavior: "smooth"

        });

}


function scrollToFeatures() {

    document
        .getElementById("features")
        .scrollIntoView({

            behavior: "smooth"

        });

}



/* =====================================================
   CLASS SELECTION
===================================================== */

function continueToClass() {


    const selectedClass =
        document
            .getElementById("classSelect")
            .value;


    if (!selectedClass) {

        alert(
            "Please select your class first."
        );

        return;

    }


    /*
        TEMPORARY:

        Later we will replace this with
        dynamic routing, for example:

        /class/3
        /class/4
        ...
        /class/12

        The backend will then load the
        correct subjects and syllabus.
    */


    alert(
        "Opening Class " +
        selectedClass +
        "..."
    );

}



/* =====================================================
   LOGIN
===================================================== */

function openLogin() {

    document
        .getElementById("loginModal")
        .classList
        .add("active");

}


function closeLogin() {

    document
        .getElementById("loginModal")
        .classList
        .remove("active");

}


function login() {


    const email =
        document
            .getElementById("email")
            .value;


    const password =
        document
            .getElementById("password")
            .value;


    if (!email || !password) {

        alert(
            "Please enter your email and password."
        );

        return;

    }


    /*
        BACKEND WILL BE CONNECTED HERE.

        Example later:

        fetch("/api/login", {
            method: "POST",
            ...
        });
    */


    alert(
        "Login system will be connected to the backend."
    );

}



/* =====================================================
   CLOSE LOGIN WHEN CLICKING OUTSIDE
===================================================== */

document
    .getElementById("loginModal")
    .addEventListener(
        "click",
        function(event) {

            if (
                event.target === this
            ) {

                closeLogin();

            }

        }
    );


</script>


