            background: #6366f1;

            color: white;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.2s;

        }


        .continue-btn:hover {

            background: #818cf8;

            transform: translateY(-2px);

        }


        /* =====================================================
           FOOTER
        ===================================================== */

        footer {

            background: #111827;

            color: white;

            padding: 45px 8%;

            text-align: center;

        }


        footer h3 {

            font-size: 22px;

        }


        footer p {

            color: #9ca3af;

            margin-top: 8px;

        }


        /* =====================================================
           LOGIN MODAL
        ===================================================== */

        .modal {

            display: none;

