           HERO
        ===================================================== */

        .hero {

            min-height: 600px;

            display: flex;

            align-items: center;

            padding: 80px 8%;

            position: relative;

            overflow: hidden;


            /*
                Background image
            */

            background-image:

                linear-gradient(
                    rgba(238,242,255,0.88),
                    rgba(255,255,255,0.92)
