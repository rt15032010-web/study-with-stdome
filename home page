            color: white;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 21px;

        }


        /* NAVIGATION */

        .nav-right {

            display: flex;

            align-items: center;

            gap: 8px;

        }


        .nav-btn {

            border: none;

            background: transparent;

            padding: 10px 15px;

            border-radius: 8px;

            cursor: pointer;

            color: #374151;

            font-size: 15px;

            transition: 0.2s;

        }


        .nav-btn:hover {

            background: #eef2ff;

            color: #4f46e5;

        }


        /* LOGIN BUTTON */

